<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WPF tray app. Phase-1 skeleton: a notification-area icon + "Launch new
    instance" + running count + quit, wiring Core (selection) and Native (the
    actual handle close). Full parity UI (flyout, Preferences, About,
    Onboarding, What's New) is Phase 3.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WeChatMulti.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WeChatMulti</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled tray + exe icon (generated from the jade Stack mark). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeChatMulti.Core\WeChatMulti.Core.csproj" />
    <ProjectReference Include="..\WeChatMulti.Native\WeChatMulti.Native.csproj" />
  </ItemGroup>

</Project>
